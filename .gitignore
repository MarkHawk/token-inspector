# Keys and certificates: never committed, except public material in
# samples/lab/ (sanitised captures). Generated samples are rebuilt at run time.
*.pem
*.key
*.p12
*.pfx
!samples/lab/*.pem
!samples/lab/**/*.pem
samples/generated/
